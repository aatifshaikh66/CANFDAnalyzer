/*****************************************************************************
 **@Function 		  	: 	FnHALCANFD_Init
 **@Descriptions		:	Initializes FDCAN1 and starts it. It calls MX_FDCAN1_Init (bit timing,
 **						message RAM layout and, through HAL_FDCAN_MspInit, the clock source, GPIO
 **						pins and NVIC), loads the default Tx frame parameters, sets the global
 **						filter so that every standard and extended frame goes into Rx FIFO0,
 **						enables the "new message in Rx FIFO0" interrupt and starts the peripheral.
 **						Has to be called once, after the system clock is configured.
 **@parameters			:	None
 **@return				: 	None
*****************************************************************************/
void FnHALCANFD_Init(void)
{
	/*init the FDCAN peripheral: bit timing, message RAM layout and, through
	  HAL_FDCAN_MspInit, the clock source, the GPIO pins and the NVIC*/
	MX_FDCAN1_Init( );

	/*set the default TX frame parameters (extended ID, FD format, BRS on)*/
	FnHALCANFD_TXConfig( );

	/*global filter, since no individual filters are configured (analyzer mode):
	  - standard ID frames that match no filter -> accept into Rx FIFO0
	  - extended ID frames that match no filter -> accept into Rx FIFO0
	  - remote frames are filtered like data frames, so they also end up
	    in Rx FIFO0 (FDCAN_REJECT_REMOTE would drop them)
	  has to be called before HAL_FDCAN_Start*/
	HAL_FDCAN_ConfigGlobalFilter(&hfdcan1,
	        FDCAN_ACCEPT_IN_RX_FIFO0, FDCAN_ACCEPT_IN_RX_FIFO0,
	        FDCAN_FILTER_REMOTE, FDCAN_FILTER_REMOTE);

	/*enable the interrupt for a new message in Rx FIFO0;
	  HAL_FDCAN_RxFifo0Callback is then called from the IRQ handler.
	  The last parameter is unused for the Rx FIFO notifications*/
	HAL_FDCAN_ActivateNotification(&hfdcan1, FDCAN_IT_RX_FIFO0_NEW_MESSAGE, 0);

	/*leave the init mode and join the bus (internal loopback for now);
	  from here on frames can be sent and received*/
	HAL_FDCAN_Start(&hfdcan1);

}

/*****************************************************************************
 **@Function 		  	: 	FnHALCANFD_TXConfig
 **@Descriptions		:	Sets the default parameters of the global stFDCANTxHeader: extended ID, data
 **						frame, ESI active, CAN FD format with bit rate switch, no Tx events.
 **						The Identifier and the DataLength are set per frame in
 **						FnHALCANFD_SendData.
 **@parameters			:	None
 **@return				: 	None
*****************************************************************************/
void FnHALCANFD_TXConfig(void)
{
	/*29-bit extended identifier (the SAMV71 uses extended IDs)*/
	stFDCANTxHeader.IdType              = FDCAN_EXTENDED_ID;

	/*data frame; CAN FD has no remote frames*/
	stFDCANTxHeader.TxFrameType         = FDCAN_DATA_FRAME;

	/*ESI bit follows the node's real error state: dominant while error active,
	  the hardware sets it recessive by itself if the node becomes error passive
	  (FDCAN_ESI_PASSIVE would force it recessive)*/
	stFDCANTxHeader.ErrorStateIndicator = FDCAN_ESI_ACTIVE;

	/*switch to the data bit rate (500 kbit/s) for the data phase;
	  only effective because the frame format in the init is FDCAN_FRAME_FD_BRS*/
	stFDCANTxHeader.BitRateSwitch       = FDCAN_BRS_ON;

	/*send as a CAN FD frame (up to 64 bytes) and not as a classic CAN frame*/
	stFDCANTxHeader.FDFormat            = FDCAN_FD_CAN;

	/*do not store a Tx event after sending (TxEventsNbr is 0 in the init)*/
	stFDCANTxHeader.TxEventFifoControl  = FDCAN_NO_TX_EVENTS;

	/*marker copied into the Tx event; unused while Tx events are off*/
	stFDCANTxHeader.MessageMarker       = (uint8_t)0x00;

	/*Identifier and DataLength are set per frame in FnHALCANFD_SendData*/
}

/*****************************************************************************
 **@Function 		  	: 	FnCANFdSetSTDDataLength
 **@Descriptions		:	Converts a number of data bytes into the DLC code of the next valid
 **						CAN FD frame length (0-8, 12, 16, 20, 24, 32, 48, 64 bytes). A length
 **						that is not valid is rounded up, for example 10 bytes -> 12 bytes.
 **						Values above 64 are limited to 64 bytes.
 **@parameters			:	DataLength	: number of data bytes (0..64)
 **@return				: 	DLC code (FDCAN_DLC_BYTES_x) to be used in stFDCANTxHeader.DataLength
*****************************************************************************/
uint32_t FnCANFdSetSTDDataLength(uint8_t DataLength)
{
	if (DataLength < (uint8_t)9)
		return DataLength;
	else if (DataLength > (uint8_t)8  && DataLength < (uint8_t)13 )
		 return FDCAN_DLC_BYTES_12;
	else if (DataLength > (uint8_t)12 && DataLength < (uint8_t)17 )
		 return FDCAN_DLC_BYTES_16;
	else if (DataLength > (uint8_t)16 && DataLength < (uint8_t)21 )
		 return FDCAN_DLC_BYTES_20;
	else if (DataLength > (uint8_t)20 && DataLength < (uint8_t)25 )
		 return FDCAN_DLC_BYTES_24;
	else if (DataLength > (uint8_t)24 && DataLength < (uint8_t)33 )
		 return FDCAN_DLC_BYTES_32;
	else if (DataLength > (uint8_t)32 && DataLength < (uint8_t)49 )
		 return FDCAN_DLC_BYTES_48;
	else return FDCAN_DLC_BYTES_64;
}

/*****************************************************************************
 **@Function 		  	:
 **@Descriptions		:
 **@parameters			: 	None
 **@return				: 	None
*****************************************************************************/
uint32_t FnCANFdReadSTDDataLength(uint8_t DataLength)
{
	switch(DataLength)
	{
		case FDCAN_DLC_BYTES_0: return FDCAN_DLC_BYTES_0;
		case FDCAN_DLC_BYTES_1: return FDCAN_DLC_BYTES_1;
		case FDCAN_DLC_BYTES_2: return FDCAN_DLC_BYTES_2;
		case FDCAN_DLC_BYTES_3: return FDCAN_DLC_BYTES_3;
		case FDCAN_DLC_BYTES_4: return FDCAN_DLC_BYTES_4;
		case FDCAN_DLC_BYTES_5: return FDCAN_DLC_BYTES_5;
		case FDCAN_DLC_BYTES_6: return FDCAN_DLC_BYTES_6;
		case FDCAN_DLC_BYTES_7: return FDCAN_DLC_BYTES_7;
		case FDCAN_DLC_BYTES_8: return FDCAN_DLC_BYTES_8;
		case FDCAN_DLC_BYTES_12: return (uint8_t)12;
		case FDCAN_DLC_BYTES_16: return (uint8_t)16;
		case FDCAN_DLC_BYTES_20: return (uint8_t)20;
		case FDCAN_DLC_BYTES_24: return (uint8_t)24;
		case FDCAN_DLC_BYTES_32: return (uint8_t)32;
		case FDCAN_DLC_BYTES_48: return (uint8_t)48;
		case FDCAN_DLC_BYTES_64: return (uint8_t)64;
		default: return (uint8_t)64;
	}

	 return (uint8_t)64;
}

/*****************************************************************************
 **@Function 		  	: 	FnHALCANFD_SendData
 **@Descriptions		:	Queues one CAN FD frame in the Tx FIFO of FDCAN1. The frame uses the
 **						default parameters of FnHALCANFD_TXConfig. The length is rounded up to
 **						the next valid CAN FD length and the extra bytes are padded with 0.
 **						The function does not wait: if the Tx FIFO is full the frame is not
 **						queued. It uses the global stFDCANTxHeader, so it must not be called from the
 **						main loop and from an interrupt at the same time.
 **@parameters			:	Identifier	: 29-bit extended identifier of the frame
 **						DataLength	: number of data bytes (0..64, larger values are cut to 64)
 **						ui8Data		: pointer to the data (at least DataLength bytes)
 **@return				: 	HAL_OK		: frame queued, the FDCAN sends it when the bus is free
 **						HAL_BUSY	: Tx FIFO is full, frame not queued
 **						HAL_ERROR	: the HAL rejected the frame (for example FDCAN not started)
*****************************************************************************/
HAL_StatusTypeDef FnHALCANFD_SendData(uint32_t Identifier, uint8_t DataLength, uint8_t *ui8Data)
{

	/*local frame buffer, sized for the largest frame; the bytes after the
	  original data stay 0 and become the padding*/
	uint8_t u8DataAndPadd[defCANFD_MAX_LD] = {RESET};

	/*truncate the data length if it is more than 64 bytes, so the copy below
	  can never overflow the local buffer*/
	if (DataLength > defCANFD_MAX_LD) DataLength = defCANFD_MAX_LD;

	/*check that the Tx FIFO has a free element before changing anything;
	  the caller can retry later when the FIFO has drained*/
	if (HAL_FDCAN_GetTxFifoFreeLevel(&hfdcan1) == RESET)
		return HAL_BUSY;

	/*set the identifier of this frame*/
	stFDCANTxHeader.Identifier = Identifier;

	/*convert the byte count into the DLC code of the next valid CAN FD length
	  (for example 10 bytes -> DLC for 12 bytes)*/
	stFDCANTxHeader.DataLength = FnCANFdSetSTDDataLength(DataLength);

	/*copy the original data; the bytes behind it stay 0 as padding*/
	if (DataLength > RESET)
		memcpy(u8DataAndPadd, ui8Data, DataLength);

	/*add the frame to the Tx FIFO (the HAL copies it into the message RAM, so
	  the local buffer can be reused right away) and return the HAL result;
	  the transmission starts automatically, no Tx request call is needed*/
	return HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1, &stFDCANTxHeader, u8DataAndPadd);

}

/*****************************************************************************
 **@Function 		  	: 	HAL_FDCAN_RxFifo0Callback
 **@Descriptions		:	Overrides the weak HAL callback. It is called by HAL_FDCAN_IRQHandler
 **						when Rx FIFO0 has received a new message (or has lost one). It must stay
 **						short: it only signals the main loop (or copies the frame into the
 **						ring buffer) and counts lost messages. No printf in here.
 **@parameters			:	hfdcan		: handle of the FDCAN that raised the interrupt
 **						RxFifo0ITs	: interrupt flags of Rx FIFO0 (FDCAN_IT_RX_FIFO0_x)
 **@return				: 	None
*****************************************************************************/
void HAL_FDCAN_RxFifo0Callback(FDCAN_HandleTypeDef *h, uint32_t RxFifo0ITs)
{
	/*every time a new message is added into the fifo, set a flag to indicate*/
    if (RxFifo0ITs & FDCAN_IT_RX_FIFO0_NEW_MESSAGE)
    	{
    	//do not add too many things here to keep the callback short
    		stVarCANFD.ui8CANRxFameCount++;
    	}

    if (RxFifo0ITs & FDCAN_IT_RX_FIFO0_MESSAGE_LOST)
    	stVarCANFD.ui8CANRxFameLost++;
}


/*****************************************************************************
 **@Function 		  	: 	FnFDCANFrameParse
 **@Descriptions		:	If Rx FIFO0 holds a frame, reads one frame, fills stVarCANFD (ID,
 **						length, error state, time of processing) and calls
 **						FnFDCANFrameProcess. One frame per call, so the main loop stays
 **						responsive; call it on every pass of the main loop.
 **@parameters			:	None
 **@return				: 	None
*****************************************************************************/
void FnFDCANFrameParse(void)
{
	//check if there is the controller receive a CANFD frame
	//Check how many frames are available in the fifo
	if(HAL_FDCAN_GetRxFifoFillLevel(&hfdcan1, FDCAN_RX_FIFO0) > RESET )
	{
		_GREEN_LED_HIGH;

		//read one frame, the data has been directly stored in the stVarCANFD.u8CANData
		 if (HAL_FDCAN_GetRxMessage(&hfdcan1, FDCAN_RX_FIFO0, &stFDCANRxHeader, stVarCANFD.u8CANData.u8) != HAL_OK)
			 FnFDCANFrameError();

		 //parse and process the frame
		 stVarCANFD.unCANID.u32  = stFDCANRxHeader.Identifier;
		 stVarCANFD.u8CANDataLen = FnCANFdReadSTDDataLength(stFDCANRxHeader.DataLength);
		 stVarCANFD.u32CANErrorStateIndicator = stFDCANRxHeader.ErrorStateIndicator;

		 /*it will store the processing time period*/
		 stVarCANFD.u32CANTimeHour = stVarTimer.u32TimerCount1hour;
		 stVarCANFD.u32CANTimeMin  = stVarTimer.u32TimerCount1min;
		 stVarCANFD.u32CANTimeSec  = stVarTimer.u32TimerCount1sec;
		 stVarCANFD.u32CANTimeMiliSec = stVarTimer.u16TimerCount1000ms;

		 /*
		 stVarCANFD.u8CANFlags = (stFDCANRxHeader.IdType == FDCAN_EXTENDED_ID)
							   | ((stFDCANRxHeader.FDFormat == FDCAN_FD_CAN) << 1)
							   | ((stFDCANRxHeader.BitRateSwitch == FDCAN_BRS_ON) << 2)
							   | ((stFDCANRxHeader.ErrorStateIndicator == FDCAN_ESI_PASSIVE) << 3);

		*/

		 FnFDCANFrameProcess(&stVarCANFD);
		 stVarCANFD.ui8CANRxProcessCount++;
		 _GREEN_LED_LOW;
	}
}



/*****************************************************************************
 **@Function 		  	: 	PUTCHAR_PROTOTYPE
 **@Descriptions		: 	printf prototype
 **@parameters			: 	None
 **@return				: 	None
*****************************************************************************/
void FnFDCANFrameProcess(stCANFD *stVarCANFD)
{

	char s8PrintBuff[(uint8_t)200] = {'\0'};
	uint8_t u8Index = RESET;
	memset(s8PrintBuff, 0, sizeof(s8PrintBuff));
	memset(stVarCANFD->s8CANDpayload, 0, sizeof(stVarCANFD->s8CANDpayload));

	/*make a datastring*/
	if (stVarCANFD->u8CANDataLen != FDCAN_DLC_BYTES_0)
	{
		//copy the first start of the array ' [ '
		u8Index += sprintf(&s8PrintBuff[u8Index],"[");

		for (uint8_t u8Count = 0; u8Count < stVarCANFD->u8CANDataLen; u8Count++)
			if (u8Count == stVarCANFD->u8CANDataLen - (uint8_t)1)
				u8Index += sprintf(&s8PrintBuff[u8Index], "%02X]", stVarCANFD->u8CANData.u8[u8Count]);
			else
				u8Index += sprintf(&s8PrintBuff[u8Index], "%02X,", stVarCANFD->u8CANData.u8[u8Count]);

		s8PrintBuff[u8Index] = '\0';
	}
	else
	{
		u8Index +=sprintf(&s8PrintBuff[u8Index],"['0']");
		s8PrintBuff[u8Index] = '\0';
	}





	sprintf((char *)stVarCANFD->s8CANDpayload,
			"{'ft':'2',\r\n"
			"'Time': '%02luh.%02lum.%02lus.%03lums',\r\n"
			"'ID': [%02X,%02X,%02X,%02X]',\r\n"
			"'Datalength': '%u',\r\n"
			"'Data': %s}\r\n\n",
			stVarCANFD->u32CANTimeHour, stVarCANFD->u32CANTimeMin,stVarCANFD->u32CANTimeSec, stVarCANFD->u32CANTimeMiliSec,
			stVarCANFD->unCANID.u8[3], stVarCANFD->unCANID.u8[2], stVarCANFD->unCANID.u8[1], stVarCANFD->unCANID.u8[0],
			stVarCANFD->u8CANDataLen,
			s8PrintBuff);

	printf("%s",stVarCANFD->s8CANDpayload);
}

