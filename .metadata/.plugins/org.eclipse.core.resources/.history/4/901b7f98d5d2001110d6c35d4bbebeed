/*****************************************************************************
 **@Function 		  	: 	MX_FDCAN1_Init
 **@Descriptions		:	CubeMX generated. Fills the hfdcan1 handle and calls HAL_FDCAN_Init.
 **						Settings: CAN FD with bit rate switch, internal loopback mode,
 **						auto retransmission on, nominal bit timing 250 kbit/s (prescaler 5,
 **						Seg1 34, Seg2 5, SJW 5), data bit timing 500 kbit/s (prescaler 4,
 **						Seg1 22, Seg2 2, SJW 2) for a 50 MHz kernel clock. Message RAM:
 **						Rx FIFO0 with 64 elements of 64 bytes, Tx FIFO queue with 30
 **						elements of 64 bytes, no filters, no Rx FIFO1, no Rx buffers,
 **						no Tx buffers, no Tx events.
 **						HAL_FDCAN_Init calls HAL_FDCAN_MspInit by itself, so there is no
 **						need to call it. It does not start the peripheral.
 **@parameters			:	None
 **@return				: 	None (goes to Error_Handler if HAL_FDCAN_Init fails)
*****************************************************************************/
void MX_FDCAN1_Init(void)
{

  /*FDCAN1 peripheral instance that this handle controls*/
  hfdcan1.Instance = FDCAN1;

	/*frame format: CAN FD frames with bit rate switching allowed (the data phase can
	run at the data bit rate when the BRS bit of the frame is set). Classic CAN frames
	are still received, they just have no data phase switch. FDCAN_FRAME_CLASSIC would
	accept only 8-byte CAN 2.0 frames*/
  hfdcan1.Init.FrameFormat = FDCAN_FRAME_FD_BRS;

  /*operating mode of the FDCAN. The mode is chosen at init time, so the simplest way to
    change it is a compile-time switch. Overview:

    FDCAN_MODE_NORMAL
      - Full participation on the bus: receives, sends, acknowledges every frame it
        received correctly (the ACK does not depend on the filters) and sends active error
        flags when it detects an error.
      - Needs a transceiver and at least one other node (an ACK is required for a
        successful transmission).
      - Use: the real application, for example the analyzer sending commands as a second
        master, and when the analyzer is the only other node that ACKs the SAMV71.

    FDCAN_MODE_RESTRICTED_OPERATION
      - Receives data frames and acknowledges valid frames, but never sends data frames,
        remote frames, active error flags or overload flags. After an error it stays silent
        and waits until the bus is idle again.
      - Cannot transmit. The hardware can also enter this mode by itself after a message
        RAM access failure.
      - Use: a receive-only node that must still give the ACK, for example a sniffer on a
        bus where it is the only other node, so the transmitter does not see ACK errors.

    FDCAN_MODE_BUS_MONITORING
      - Receives valid frames but only sends recessive bits: no ACK, no error flags, no
        transmission. Dominant bits that the node would send are looped back internally,
        so the node never disturbs the bus.
      - Frames queued for transmission are not sent.
      - Because it does not ACK, at least one other node on the bus must ACK the frames.
      - Use: a completely passive analyzer on a bus that already has other receivers, and
        a safe first connection to an unknown bus (wrong bit timing cannot disturb it).

    FDCAN_MODE_INTERNAL_LOOPBACK
      - The transmitter is connected to the receiver inside the chip. The CAN_RX pin is
        ignored and CAN_TX stays recessive, so nothing appears on the bus. Frames can be
        sent without a transceiver, a bus or another node, acknowledge errors are ignored,
        and every frame sent is received by this node.
      - Use: developing and testing the driver and the parser without hardware (the
        current setting).

    FDCAN_MODE_EXTERNAL_LOOPBACK
      - The same internal feedback as above (the CAN_RX pin is ignored, acknowledge errors
        are ignored), but the CAN_TX pin is driven, so the frames can be seen at the pin and
        are sent onto the bus if a transceiver is connected.
      - Use: testing the pin, the transceiver output and the bit timing with a scope or logic
        analyzer without a second node. Do not use it on a live bus, because the frames
        really are transmitted.

    Modes that can transmit: NORMAL, INTERNAL_LOOPBACK (internally only) and
    EXTERNAL_LOOPBACK. Modes that cannot: RESTRICTED_OPERATION and BUS_MONITORING.
    Suggested order for this project: INTERNAL_LOOPBACK (now) -> EXTERNAL_LOOPBACK
    (pins and transceiver, no live bus) -> BUS_MONITORING (first connection to the SAMV71)
    -> NORMAL (analyzer plus command sending)*/
  hfdcan1.Init.Mode = FDCAN_MODE_INTERNAL_LOOPBACK;

  /*automatic retransmission: a frame that lost arbitration or was hit by an error is
    sent again by the hardware until it succeeds*/
  hfdcan1.Init.AutoRetransmission = ENABLE;

  /*transmit pause: disabled, the node does not insert an extra pause of 2 bit times
    after its own successful transmission*/
  hfdcan1.Init.TransmitPause = DISABLE;

  /*protocol exception handling: enabled. A frame with the reserved bit received
    recessive (a possible future protocol) makes the node wait until the bus is idle
    instead of counting it as an error*/
  hfdcan1.Init.ProtocolException = ENABLE;

  /*----- NOMINAL bit timing: arbitration phase and control fields, 250 kbit/s -----
    tq = prescaler / kernel clock = 5 / 50 MHz = 100 ns
    bit time = (1 sync + Seg1 + Seg2) x tq = (1 + 34 + 5) x 100 ns = 4 us = 250 kbit/s
    sample point = (1 + Seg1) / (1 + Seg1 + Seg2) = 35 / 40 = 87.5 %*/
  hfdcan1.Init.NominalPrescaler = 5;       /*divider of the kernel clock (1 to 512)*/
  hfdcan1.Init.NominalSyncJumpWidth = 5;   /*maximum resynchronization step in tq, keep <= Seg2*/
  hfdcan1.Init.NominalTimeSeg1 = 34;       /*tq before the sample point (propagation + phase 1)*/
  hfdcan1.Init.NominalTimeSeg2 = 5;        /*tq after the sample point (phase 2)*/

  /*----- DATA bit timing: data phase of frames with BRS, 500 kbit/s -----
    tq = 4 / 50 MHz = 80 ns
    bit time = (1 + 22 + 2) x 80 ns = 2 us = 500 kbit/s
    sample point = (1 + 22) / 25 = 92 %
    limits of the data fields: prescaler 1-32, Seg1 1-31, Seg2 1-16, SJW 1-16*/
  hfdcan1.Init.DataPrescaler = 4;
  hfdcan1.Init.DataSyncJumpWidth = 2;      /*keep <= Seg2*/
  hfdcan1.Init.DataTimeSeg1 = 22;
  hfdcan1.Init.DataTimeSeg2 = 2;

  /*----- message RAM layout (shared by all FDCAN instances, sizes in 32-bit words) -----
    start of this instance's area inside the message RAM, in words. 0 for the first
    instance, a second FDCAN instance must start behind the end of this one*/
  hfdcan1.Init.MessageRAMOffset = 0;

  /*number of filter elements in the message RAM. 0 = no individual filters, what
    happens to a frame is decided only by the global filter, which is set in
    FnHALCANFD_Init (accept everything into Rx FIFO0)*/
  hfdcan1.Init.StdFiltersNbr = 0;          /*11-bit identifier filters*/
  hfdcan1.Init.ExtFiltersNbr = 0;          /*29-bit identifier filters*/

  /*Rx FIFO0: the main receive queue. 64 elements, each holds up to 64 data bytes
    (2 header words + 16 data words = 18 words), so 64 x 18 = 1152 words.
    If it is full the next frame is lost (message lost interrupt/flag)*/
  hfdcan1.Init.RxFifo0ElmtsNbr = 64;
  hfdcan1.Init.RxFifo0ElmtSize = FDCAN_DATA_BYTES_64;

  /*Rx FIFO1: not used, no elements; the size is irrelevant and set to the minimum*/
  hfdcan1.Init.RxFifo1ElmtsNbr = 0;
  hfdcan1.Init.RxFifo1ElmtSize = FDCAN_DATA_BYTES_8;

  /*dedicated Rx buffers (for individual identifiers selected by a filter): not
    used, no elements; the size is irrelevant*/
  hfdcan1.Init.RxBuffersNbr = 0;
  hfdcan1.Init.RxBufferSize = FDCAN_DATA_BYTES_8;

  /*Tx event FIFO: no elements, no log of transmitted frames. Matches
    TxEventFifoControl = FDCAN_NO_TX_EVENTS in FnHALCANFD_TXConfig*/
  hfdcan1.Init.TxEventsNbr = 0;

  /*dedicated Tx buffers: none. As a consequence HAL_FDCAN_AddMessageToTxBuffer and
    HAL_FDCAN_EnableTxBufferRequest cannot be used, frames are queued with
    HAL_FDCAN_AddMessageToTxFifoQ*/
  hfdcan1.Init.TxBuffersNbr = 0;

  /*Tx FIFO/queue: 30 frames can wait for transmission (together with the dedicated
    buffers at most 32). FIFO operation sends the frames in the order they were
    added; FDCAN_TX_QUEUE_OPERATION would send the lowest identifier first*/
  hfdcan1.Init.TxFifoQueueElmtsNbr = 30;
  hfdcan1.Init.TxFifoQueueMode = FDCAN_TX_FIFO_OPERATION;

  /*data bytes per Tx element (applies to all Tx elements): 64 bytes, 18 words each,
    30 x 18 = 540 words*/
  hfdcan1.Init.TxElmtSize = FDCAN_DATA_BYTES_64;

  /*timestamp counter: one tick = 16 nominal bit times (prescaler 16), internal counter*/
  HAL_FDCAN_ConfigTimestampCounter(&hfdcan1, FDCAN_TIMESTAMP_PRESC_16);
  HAL_FDCAN_EnableTimestampCounter(&hfdcan1, FDCAN_TIMESTAMP_INTERNAL);


  /*write the configuration to the peripheral. On the first call HAL_FDCAN_Init
    calls HAL_FDCAN_MspInit (kernel clock, peripheral clock, pins, NVIC), enters the
    init mode, sets the bit timing and the message RAM layout. It fails if the
    parameters are invalid or the kernel clock is missing. It does not start the
    node: HAL_FDCAN_Start has to be called afterwards*/
  if (HAL_FDCAN_Init(&hfdcan1) != HAL_OK)
  {
    Error_Handler();
  }

}

