		/*reset the watchdog every 10ms*/
		hdefIWDG_RESET
		FnFDCANFrameParse();
	}

	/*execute event at every 100ms*/
	if (stVarTimer.u8TimeFlag_100msec == SET)
	{   stVarTimer.u8TimeFlag_100msec= RESET;


	}

	/*execute event at every 1s*/
