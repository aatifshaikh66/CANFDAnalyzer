/* TIM3 init function */
void MX_TIM3_Init(void)
{

  /* Peripheral clock enable */
  LL_TIM_InitTypeDef TIM_InitStruct = {0};
  LL_APB1_GRP1_EnableClock(LL_APB1_GRP1_PERIPH_TIM3);

  /* TIM3 interrupt Init */
  NVIC_SetPriority(TIM3_IRQn, NVIC_EncodePriority(NVIC_GetPriorityGrouping(),0, 1));
  NVIC_EnableIRQ(TIM3_IRQn);

  TIM_InitStruct.Prescaler = 99;
  TIM_InitStruct.CounterMode = LL_TIM_COUNTERMODE_UP;
  TIM_InitStruct.Autoreload = 999;
  TIM_InitStruct.ClockDivision = LL_TIM_CLOCKDIVISION_DIV1;
  LL_TIM_Init(hdefTIMER, &TIM_InitStruct);
  LL_TIM_EnableARRPreload(hdefTIMER);
  LL_TIM_SetClockSource(hdefTIMER, LL_TIM_CLOCKSOURCE_INTERNAL);
  LL_TIM_SetTriggerOutput(hdefTIMER, LL_TIM_TRGO_RESET);
  LL_TIM_DisableMasterSlaveMode(hdefTIMER);

  LL_TIM_ClearFlag_UPDATE(hdefTIMER);   /* LL_TIM_Init generates an update event, which sets this flag */
  LL_TIM_EnableIT_UPDATE(hdefTIMER);    /* enable the update interrupt */
  LL_TIM_EnableCounter(hdefTIMER);      /* start counting */

}

/*****************************************************************************
 **@Function 		  	: 	Configure_IWDG
 **@Descriptions		:	Starts the independent watchdog IWDG1 with a timeout of about 4 s
 **						(LSI 32 kHz / 32, reload 3999). If it is not refreshed within that
 **						time, the board resets. Once started it cannot be stopped.
 **@parameters			:	None
 **@return				: 	None
*****************************************************************************/
void Configure_IWDG(void)
{

	/* optional, for debugging: stop the watchdog while the core is halted.
	   Check the exact name in stm32h7xx_ll_dbgmcu.h of your LL version */
	/* LL_DBGMCU_APB4_GRP1_FreezePeriph(LL_DBGMCU_APB4_GRP1_IWDG1_STOP); */

	LL_IWDG_Enable(IWDG1);                           /* start (also switches the LSI on) */
	LL_IWDG_EnableWriteAccess(IWDG1);
	LL_IWDG_SetPrescaler(IWDG1, LL_IWDG_PRESCALER_32);   /* 32 kHz / 32 = 1 kHz */
	LL_IWDG_SetReloadCounter(IWDG1, 3999);               /* 4000 ticks = 4 s */
	while (LL_IWDG_IsReady(IWDG1) != 1) { }          /* wait until the values are applied */
	LL_IWDG_ReloadCounter(IWDG1);                    /* first refresh */
}

