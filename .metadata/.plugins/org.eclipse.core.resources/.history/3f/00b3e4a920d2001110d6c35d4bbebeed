	{   stVarTimer.u8TimeFlag_1sec= RESET;

		printf("Time=%lu CAN RX=%lu CAN PR=%lu \n\r",
				stVarTimer.u32TimerCount1sec, stVarCANFD.ui8CANRxFameCount, stVarCANFD.ui8CANRxProcessCount);
