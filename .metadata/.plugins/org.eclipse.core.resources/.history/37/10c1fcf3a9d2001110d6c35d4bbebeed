/**
  * @brief This function handles TIM3 global interrupt.
  */
void TIM3_IRQHandler(void)
{
/* Check whether update interrupt is pending */
	if( LL_TIM_IsActiveFlag_UPDATE(hdefTIMER) == SET )
	{
		/* Clear the update interrupt flag*/
		LL_TIM_ClearFlag_UPDATE(hdefTIMER);

		/*Check every 1ms*/
		FnUsartCheckINTR( );

		stVarTimer.u8TimerCount1ms++;
		stVarTimer.u16TimerCount1000ms++;

		/*10ms flag********************************/
		if (stVarTimer.u8TimerCount1ms >= (uint8_t)10)
		{
			stVarTimer.u8TimerCount10ms++;
			stVarTimer.u8TimeFlag_10msec= SET;
			stVarTimer.u8TimerCount1ms  = RESET;
		}
		/*100ms flag********************************/
		if (stVarTimer.u8TimerCount10ms >= (uint8_t)10)
		{
			stVarTimer.u8TimerCount100ms++;
			stVarTimer.u8TimeFlag_100msec= SET;
			stVarTimer.u8TimerCount10ms  = RESET;
		}
		/*1s flag********************************/
		if (stVarTimer.u8TimerCount100ms >= (uint8_t)10)
		{
			stVarTimer.u32TimerCount1sec++;
			stVarTimer.u8TimeFlag_1sec   = SET;
			stVarTimer.u8TimerCount100ms = RESET;

			if (stVarTimer.u32TimerCount1sec % (uint8_t)5 == RESET)
				stVarTimer.u8TimeFlag_5sec = SET ;

			if (stVarTimer.u32TimerCount1sec % (uint8_t)10 == RESET)
				stVarTimer.u8TimeFlag_10sec = SET ;
		}




	}
}

/**
  * @brief This function handles USART3 global interrupt.
  */
void USART3_IRQHandler(void)
{

/* overrun: clear it, otherwise this interrupt fires forever */
if (LL_USART_IsActiveFlag_ORE(hdefCOM_PORT))
{
	LL_USART_ClearFlag_ORE(hdefCOM_PORT);
	//stVarUSART.u32RxOverrun++;
}

/* Check RXNE flag value in ISR register */
if(LL_USART_IsActiveFlag_RXNE(hdefCOM_PORT) &&
   LL_USART_IsEnabledIT_RXNE (hdefCOM_PORT))
	{
		uint8_t u8TemChar;
		/* Read one byte from the receive data register */
		u8TemChar = LL_USART_ReceiveData8(hdefCOM_PORT);

		if (stVarUSART.u8UsartRxDataCount < hdefCOM_MAX_BUFFER)
		{
			stVarUSART.u8UsartRxBuffer [stVarUSART.u8UsartRxDataCount++] = u8TemChar;
			stVarUSART.u8UsartRxBuffer [stVarUSART.u8UsartRxDataCount]   = '\0';
		}

		/***************** FRAME TERMINATION CHECKING **************************/
		stVarUSART.u8UsartRxIntFlag =  /* a byte arrived within this ms */
		stVarUSART.u8UsartRxIntStartFlag  = SET ;  /* a frame is in progress */
	}
}




